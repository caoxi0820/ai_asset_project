{
  "name": "caoxi-agent",
  "description": "Default agent with sound notification hooks",
  "tools": [
    "*"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "skill://.kiro/skills/**/SKILL.md",
    "file://.kiro/steering/**/*.md",
    "file://AmazonQ.md",
    "file://.amazonq/rules/**/*.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "afplay /Users/caoxicz/kiro_hook_assets/spirit-orb-sfx-botw-made-with-Voicemod.mp3 &",
        "timeout_ms": 1000
      }
    ],
    "stop": [
      {
        "command": "afplay /Users/caoxicz/kiro_hook_assets/BGM_ReadRiddle.wav &",
        "timeout_ms": 1000
      }
    ],
    "preToolUse": [
      {
        "matcher": "fs_write",
        "command": "afplay /Users/caoxicz/kiro_hook_assets/botw-new-item-made-with-Voicemod.mp3 &",
        "timeout_ms": 1000
      },
      {
        "matcher": "execute_bash",
        "command": "afplay /Users/caoxicz/kiro_hook_assets/botw-new-item-made-with-Voicemod.mp3 &",
        "timeout_ms": 1000
      }
    ]
  },
  "useLegacyMcpJson": true,
